// DriveLinkUp local env. Copy to `.env.local` (never commit real secrets).

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/drivelinkup?sslmode=prefer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — transactional email (signup verify, bookings, contact).
RESEND_API_KEY=
RESEND_FROM="DriveLinkUp <noreply@drivelinkup.com>"
CONTACT_EMAIL=support@drivelinkup.com
OWNER_EMAIL=support@drivelinkup.com
# Dev/testing: redirect all outgoing email to one address.
# Leave empty in production to send to real recipients.
EMAIL_OVERRIDE_TO=

# better-auth. Generate a long random secret for local use:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-plus-character-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (better-auth socialProviders.google).
# Console → Credentials → OAuth 2.0 Client IDs. Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://www.drivelinkup.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage
BLOB_READ_WRITE_TOKEN=

# Payments (Stripe test-mode keys for local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Hourly auto-release cron (/api/cron/auto-release). Set in Vercel; never commit the value.
CRON_SECRET=

# AI
OPENAI_API_KEY=

# Optional
# NEXT_PUBLIC_API_URL=""
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Didit Free KYC (ID document) for learner verification.
# Required: DIDIT_API_KEY, DIDIT_WEBHOOK_SECRET, DIDIT_WORKFLOW_ID — see AGENTS.md.
# DIDIT_API_KEY=""
# DIDIT_WEBHOOK_SECRET=""
# DIDIT_WORKFLOW_ID=""

# Prefix local commands that should skip env checks:
#   SKIP_ENV_VALIDATION=1 npm run dev
