# DriveLinkUp local env. Copy to `.env.local` (never commit real secrets).
#
# @polsia:slot env_example start

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/drivelinkup?sslmode=prefer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — transactional email (signup verify, bookings, contact).
RESEND_API_KEY=
RESEND_FROM="DriveLinkUp <noreply@drivelinkup.com>"
CONTACT_EMAIL=support@drivelinkup.com
OWNER_EMAIL=support@drivelinkup.com
# Dev/testing: redirect all outgoing email to one address.
# Leave empty in production to send to real recipients.
EMAIL_OVERRIDE_TO=

# better-auth. Generate a long random secret for local use:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-plus-character-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (better-auth socialProviders.google).
# Console → Credentials → OAuth 2.0 Client IDs. Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://www.drivelinkup.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional platform keys. Leave unset for a directory-only local prototype
# (email/checkout calls will fail closed; listing + booking writes still work).
# POLSIA_API_BASE_URL="https://polsia.com"
# POLSIA_API_KEY=""
# POLSIA_API_TOKEN=""
# POLSIA_AI_BASE_URL="https://polsia.com/ai/openai/v1"
# NEXT_PUBLIC_API_URL=""
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Vercel Blob — used for signup photos and school credential uploads.
# Linked automatically when you run `vercel blob create-store` on the project.
# BLOB_READ_WRITE_TOKEN=""

# Restore the database snapshot (empty catalog; users/waitlist only) with:
#   psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f ../korprivat-database/01-schema.sql
#   psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f ../korprivat-database/02-data.sql
# Then start the app. Boot seed upserts demo instructors + open slots so
# /instructors is not empty. Do not run `prisma db push` after restore —
# the dump schema is ahead of this zip in a few listing columns.
#
# Prefix local commands that should skip env checks:
#   SKIP_ENV_VALIDATION=1 npm run dev

# @polsia:slot env_example end

# Didit Free KYC (ID document) for learner verification.
# Required: DIDIT_API_KEY, DIDIT_WEBHOOK_SECRET, DIDIT_WORKFLOW_ID — see AGENTS.md.
# DIDIT_API_KEY=""
# DIDIT_WEBHOOK_SECRET=""
# DIDIT_WORKFLOW_ID=""
