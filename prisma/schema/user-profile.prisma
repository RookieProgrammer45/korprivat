//
// `User` lives in the framework-owned prisma/schema/auth.prisma (Prisma can't
// extend a model across files), so fields that are MINE — the student/instructor
// role for the marketplace and a "we already sent you a welcome" dedup marker —
// live on this user-owned model. The link to User is a plain scalar `userId`
// (per the nextjs-prisma skill: NO @relation to the framework-owned User, since
// that would require a back-relation field on User which we cannot own).
//
// `role` mirrors the existing `WaitlistRole` enum on prisma/schema/waitlist-profile.prisma:
// a user is either a learner (STUDENT) or an instructor (INSTRUCTOR), defaulting
// to STUDENT. Created with the user row via the `user.create.after` hook in
// src/lib/auth-config.ts so the row exists without an extra round trip on any
// page that reads it. `profileCompletedAt` is stamped by /api/profile/picture
// exactly when a real avatar upload lands on User.image.
model UserProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  role               Role      @default(STUDENT)
  // Signup path discriminator for role-specific onboarding:
  // LEARNER | SCHOOL | INSTRUCTOR. Nullable for legacy rows.
  signupPath         String?
  // Claimed DOB from the signup form — routing only. Never treat as verified.
  dateOfBirth        DateTime?
  // Authoritative DOB from Didit ID verification. Written ONLY by the
  // Didit webhook handler (src/app/api/webhooks/didit).
  dateOfBirthVerified DateTime?
  // Learner verification state machine — see docs/learner-verification-flow.md.
  verificationState  String    @default("SIGNED_UP")
  diditAttempts      Int       @default(0)
  diditSessionId     String?
  diditLastDecision  String?
  diditLastReason    String?
  phone              String?
  city               String?
  schoolName         String?
  organizationNumber String?
  // Years the certified instructor has held a full driving licence. Required
  // for the INSTRUCTOR signup path (must be >= 5).
  licenseHeldYears   Int?
  // Deprecated — superseded by KYC webhook DOB (facial estimation retired 2026-09-27).
  ageEstimatedYears  Float?
  // Deprecated — superseded by KYC webhook DOB (facial estimation retired 2026-09-27).
  ageCheckRequestId  String?
  // Deprecated — superseded by KYC webhook DOB (facial estimation retired 2026-09-27).
  ageCheckStatus     String?
  welcomeSentAt      DateTime?
  profileCompletedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([signupPath])
  @@map("user_profile")
}

enum Role {
  STUDENT
  INSTRUCTOR
  HANDLEDARE
}
