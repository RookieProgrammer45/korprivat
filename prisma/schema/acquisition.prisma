// Acquisition context. Empty on deploy. CLAIM_FUNNEL defaults off, so public
// profile and claim routes do not read these tables until the flag is on.
// A claim never writes SchoolAuthorizationEvent.

model ListingProspect {
  id           String   @id @default(cuid())
  legalName    String
  orgNumber    String
  country      String
  city         String
  // Teaching permission categories A, B, C, D. Not commercial authorization scopes.
  categories   String[]
  // SYNTHETIC_FIXTURE is the only source this build accepts.
  source       String
  // PENDING | ELIGIBLE | REJECTED
  eligibility  String   @default("PENDING")
  // PENDING | PASS | FAIL
  dataQuality  String   @default("PENDING")
  // PRIVATE | PUBLIC
  visibility   String   @default("PRIVATE")
  // UNCLAIMED | SUBMITTED
  claimState   String   @default("UNCLAIMED")
  policyDraft  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  claims ProspectClaim[]

  @@unique([country, orgNumber])
  @@index([visibility])
}

model ProspectClaim {
  id                     String   @id @default(cuid())
  prospectId             String
  claimantUserId         String
  identityEvidenceRef    String
  mandateEvidenceRef     String
  // PENDING_REVIEW | VERIFIED | REJECTED
  identityStatus         String   @default("PENDING_REVIEW")
  mandateStatus          String   @default("PENDING_REVIEW")
  representativeStatus   String   @default("PENDING_REVIEW")
  scopesGranted          String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  prospect ListingProspect @relation(fields: [prospectId], references: [id])

  @@index([prospectId])
}

// School-mediated instructors. An invitation does not grant commercial scopes.
// Native diary control is copied only when the school sets inventoryDelegated.

model SchoolInstructorInvitation {
  id                  String   @id @default(cuid())
  schoolListingId     String
  email               String
  teachingCategories  String[]
  inventoryDelegated  Boolean  @default(false)
  // PENDING | VERIFIED | REVOKED
  status              String   @default("PENDING")
  invitedByUserId     String
  acceptedByUserId    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  schoolListing Instructor                  @relation("SchoolInvitesInstructor", fields: [schoolListingId], references: [id])
  affiliation   SchoolInstructorAffiliation?

  @@index([schoolListingId])
  @@index([email])
}

model SchoolInstructorAffiliation {
  id                  String   @id @default(cuid())
  invitationId        String   @unique
  schoolListingId     String
  instructorUserId    String
  instructorListingId String?
  teachingCategories  String[]
  inventoryDelegated  Boolean  @default(false)
  // VERIFIED
  status              String   @default("VERIFIED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invitation    SchoolInstructorInvitation @relation(fields: [invitationId], references: [id])
  schoolListing Instructor                 @relation("SchoolAffiliatedInstructors", fields: [schoolListingId], references: [id])

  @@index([schoolListingId])
  @@index([instructorUserId])
  @@index([instructorListingId])
}
