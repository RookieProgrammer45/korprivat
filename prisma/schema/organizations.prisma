// Organizations bounded context. Schools are entities; instructor↔school
// links are Membership rows. Do not add organizationId onto Instructor.
// Membership is not deleted when someone leaves — set status REVOKED.
// Pending email invites live on MembershipInvite until accepted.

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  organizationNumber String   @unique
  vatNumber          String?
  address            String?
  postcode           String?
  city               String?
  country            String   @default("SE")
  contactEmail       String?
  contactPhone       String?
  // DRAFT | PENDING | APPROVED | REJECTED | SUSPENDED
  verificationState  String   @default("DRAFT")
  rejectionReason    String?
  stripeAccountId    String?  @unique
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  detailsSubmitted   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships Membership[]
  invites     MembershipInvite[]

  @@index([verificationState])
}

model Membership {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  // OWNER | STAFF
  role           String
  // PENDING | ACTIVE | REVOKED
  status         String    @default("PENDING")
  invitedBy      String?
  invitedAt      DateTime  @default(now())
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
}

/// Email invite before (or without) an existing User row.
model MembershipInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  // STAFF (OWNER is never invited via this table)
  role           String    @default("STAFF")
  token          String    @unique
  expiresAt      DateTime
  invitedBy      String
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([email])
}
