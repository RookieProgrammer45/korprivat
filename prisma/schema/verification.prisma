//
// Append-only events and idempotency keys for the learner age gate.
// See docs/learner-verification-flow.md §5 and AGENTS.md invariants.

/// Append-only audit of verification state transitions. No updates, no deletes.
model VerificationEvent {
  id          String   @id @default(cuid())
  subjectType String
  subjectId   String
  actorId     String?
  fromStatus  String?
  toStatus    String
  note        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
  @@map("verification_event")
}

/// Idempotency ledger for Didit webhook deliveries.
/// Prefer unique `eventId` (Didit `event_id`). Keep (diditSessionId, decision)
/// as a fallback compound key for older rows / missing event_id.
model DiditWebhookEvent {
  id             String   @id @default(cuid())
  eventId        String?  @unique
  diditSessionId String
  decision       String
  webhookType    String?
  payloadHash    String
  receivedAt     DateTime @default(now())

  @@unique([diditSessionId, decision])
  @@map("didit_webhook_event")
}
