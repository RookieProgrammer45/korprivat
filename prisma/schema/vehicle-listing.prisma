// A private owner's car, published so a signed-in buyer can find it.
// The estimate is computed from published catalogue prices. No registration
// number and no VIN are stored.

model VehicleListing {
  id             String                @id @default(cuid())
  userId         String
  country        String
  city           String
  make           String
  model          String
  year           Int?
  currency       String
  estimateAmount Int?
  estimateLow    Int?
  estimateHigh   Int?
  estimateCount  Int
  askingAmount   Int?
  note           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  conversations  VehicleConversation[]

  @@index([userId])
  @@index([country, currency])
  @@map("vehicle_listing")
}

model VehicleConversation {
  id            String           @id @default(cuid())
  listingId     String
  buyerUserId   String
  sellerUserId  String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime?
  listing       VehicleListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages      VehicleMessage[]

  @@unique([listingId, buyerUserId])
  @@index([listingId])
  @@index([buyerUserId])
  @@index([sellerUserId])
  @@map("vehicle_conversation")
}

model VehicleMessage {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  conversation   VehicleConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("vehicle_message")
}
