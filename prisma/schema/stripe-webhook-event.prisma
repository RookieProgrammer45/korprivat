/// Append-only idempotency ledger for Stripe webhook deliveries.
/// Unique on Stripe `event.id` — never update or delete rows.
model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  payloadHash String
  receivedAt  DateTime @default(now())

  @@index([eventType, receivedAt])
  @@map("stripe_webhook_event")
}
