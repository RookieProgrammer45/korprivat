// User is framework-owned, so userId is intentionally a scalar link.

enum PhotoVerificationStatus {
  STAGED
  CONFIRMED
}

model PhotoVerification {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  stagedUrl       String?
  stagedKey       String?
  stagedAt        DateTime?
  confirmedAt     DateTime?
  status          PhotoVerificationStatus?
  signupRole      Role?
  signupStartedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@map("photo_verification")
}
